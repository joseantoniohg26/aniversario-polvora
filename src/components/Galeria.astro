---
import { Image, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import distrito from '../data/distrito.json';
import Ola from './Ola.astro';

interface Foto {
  archivo: string;
  alt: string;
  pie: string;
  ajuste?: string;
}

const fotos = import.meta.glob<{ default: ImageMetadata }>('../assets/galeria/*.{jpg,jpeg,png,webp}', { eager: true });
const porNombre = Object.fromEntries(
  Object.entries(fotos).map(([ruta, m]) => [ruta.split('/').pop()!.replace(/\.[^.]+$/, ''), m.default]),
);
const items = (distrito.galeria as Foto[]).filter((f) => porNombre[f.archivo]);
const videos = await Promise.all(
  (distrito.videos ?? []).map(async (v) => {
    const src = porNombre[v.poster];
    const posterImg = src ? await getImage({ src, width: 900, format: 'webp', quality: 75 }) : null;
    return { ...v, posterUrl: posterImg?.src };
  }),
);
---
<section id="galeria" class="relative bg-crema px-4 pb-16 pt-16">
  <Ola class="text-verde-100" />
  <div class="mx-auto max-w-5xl">
    <h2 class="reveal text-4xl text-verde-900 sm:text-5xl">Fotos y videos del distrito</h2>
    <p class="reveal mt-2 text-lg text-tinta/80">Obras, educación, actividades recientes y paisajes de Pólvora.</p>

    <!-- Todas las fotos en el mismo formato; los afiches se muestran completos -->
    <div class="mt-8 grid gap-x-5 gap-y-8 sm:grid-cols-2 lg:grid-cols-3">
      {items.map((f, i) => (
        <figure class="foto reveal" style={`--i:${i % 3}`}>
          <div class:list={['overflow-hidden rounded-xl border border-verde-700/15', f.ajuste === 'contener' ? 'bg-verde-950/5' : 'bg-verde-100']}>
            <Image
              src={porNombre[f.archivo]}
              alt={f.alt}
              widths={[400, 800]}
              sizes="(min-width: 1024px) 330px, (min-width: 640px) 45vw, 92vw"
              format="webp"
              quality={75}
              loading="lazy"
              class:list={['aspect-[4/3] w-full', f.ajuste === 'contener' ? 'object-contain' : 'object-cover']}
            />
          </div>
          <figcaption class="mt-2.5 text-[0.98rem] leading-snug text-tinta/90">{f.pie}</figcaption>
        </figure>
      ))}
    </div>

    {videos.length > 0 && (
      <div class="mt-14">
        <h3 class="reveal text-2xl text-verde-900 sm:text-3xl">Videos</h3>
        <div class="mt-5 grid gap-6 md:grid-cols-2">
          {videos.map((v, i) => (
            <div class="video-card reveal overflow-hidden rounded-xl border border-verde-700/20 bg-white" style={`--i:${i}`}>
              <div class="relative bg-verde-950">
                <video
                  data-auto-video
                  controls
                  muted
                  loop
                  playsinline
                  preload="none"
                  data-poster={v.posterUrl}
                  class="aspect-video w-full object-cover"
                >
                  <source src={v.archivo} type="video/mp4" />
                </video>
                <button
                  type="button"
                  data-video-audio
                  class="absolute right-3 top-3 rounded-full border border-oro-300/70 bg-black/65 px-3 py-1 text-xs font-bold text-oro-300 backdrop-blur-sm transition-colors hover:bg-oro-300 hover:text-verde-950"
                >
                  Activar sonido
                </button>
              </div>
              <div class="px-4 py-3">
                <p class="font-display text-lg text-verde-900">{v.titulo}</p>
                <p class="text-sm text-tinta/80">{v.detalle}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    )}
  </div>
</section>
