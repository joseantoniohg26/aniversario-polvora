---
// Banderines de fiesta en SVG. Tres capas, una por color, que se mecen desfasadas.
const { class: clase = '' } = Astro.props;
const colores = ['var(--color-verde-500)', 'var(--color-oro-500)', 'var(--color-cafe-600)'];
const capas = colores.map((color, k) => ({
  color,
  demora: k * -1.1,
  banderas: Array.from({ length: 16 }, (_, i) => i * 150 + k * 50 + 4),
}));
---
<div class={`relative h-10 ${clase}`} aria-hidden="true">
  <svg class="absolute inset-0" viewBox="0 0 2400 40" preserveAspectRatio="xMidYMin slice" width="100%" height="40" focusable="false">
    <path d="M0 3H2400" stroke="var(--color-oro-500)" stroke-width="3" />
  </svg>
  {capas.map((c) => (
    <svg class="capa-bandera absolute inset-0" style={`animation-delay:${c.demora}s`} viewBox="0 0 2400 40" preserveAspectRatio="xMidYMin slice" width="100%" height="40" focusable="false">
      {c.banderas.map((x) => <path d={`M${x} 3L${x + 28} 3L${x + 14} 34Z`} fill={c.color} />)}
    </svg>
  ))}
</div>
