---
import { Image, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import distrito from '../data/distrito.json';

interface Invitado {
  nombre: string;
  detalle?: string;
  origen?: string;
  portada?: string;
  videoSrc?: string;
  videoPoster?: string;
  videoTitulo?: string;
  videoDuracion?: string;
}

const imagenes = import.meta.glob<{ default: ImageMetadata }>('../assets/artistas/*.{jpg,jpeg,png,webp}', { eager: true });
const imagenDe = Object.fromEntries(
  Object.entries(imagenes).map(([ruta, m]) => [ruta.split('/').pop()!.replace(/\.[^.]+$/, ''), m.default]),
);

const invitados = distrito.invitados as Invitado[];
const posters: Record<string, string> = {};
for (const inv of invitados) {
  if (inv.videoPoster && imagenDe[inv.videoPoster]) {
    const img = await getImage({ src: imagenDe[inv.videoPoster], width: 480, format: 'webp', quality: 75 });
    posters[inv.nombre] = img.src;
  }
}
---
{invitados.length > 0 && (
  <section id="invitados" class="bg-verde-900 px-4 py-14 text-white">
    <div class="mx-auto max-w-5xl">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <div>
          <h2 class="text-4xl text-oro-300 sm:text-5xl">Artistas invitados</h2>
          <p class="mt-2 text-lg text-white/85">Noche de fiesta social y quema de castillo · sábado 5 de diciembre</p>
        </div>
        <a
          href="#dia-5"
          class="boton-oro inline-flex items-center gap-2 rounded-full bg-oro-300 px-5 py-2.5 text-sm font-bold text-verde-950 shadow-lg"
        >
          Escuchar canciones en el Día 5
        </a>
      </div>

      <ul class="mt-8 grid gap-6 md:grid-cols-2">
        {invitados.map((inv) => (
          <li class="reveal min-w-0 rounded-2xl border border-oro-500/40 bg-verde-950/65 p-4 shadow-lg transition hover:-translate-y-1 hover:border-oro-300">
            <div class="flex items-center gap-4">
              {inv.portada && imagenDe[inv.portada] && (
                <Image
                  src={imagenDe[inv.portada]}
                  alt={inv.nombre}
                  width={180}
                  height={180}
                  format="webp"
                  quality={80}
                  loading="lazy"
                  class="h-20 w-20 shrink-0 rounded-xl border border-oro-300/50 object-cover sm:h-24 sm:w-24"
                />
              )}
              <div class="min-w-0">
                <p class="font-display text-2xl text-oro-300">{inv.nombre}</p>
                {inv.origen && <p class="text-sm font-bold text-white/90">{inv.origen}</p>}
                {inv.detalle && <p class="mt-1 text-sm text-white/85">{inv.detalle}</p>}
              </div>
            </div>

            {inv.videoSrc && (
              <div class="video-card mt-4 overflow-hidden rounded-xl border border-oro-300/40 bg-black/35">
                <div class="flex flex-wrap items-center justify-between gap-2 px-3 py-2">
                  <span class="text-sm font-bold text-oro-300">Video del afiche {inv.videoDuracion && `· ${inv.videoDuracion}`}</span>
                  <button
                    type="button"
                    data-video-audio
                    class="rounded-full border border-oro-300/70 bg-black/60 px-2.5 py-1 text-xs font-bold text-oro-300 transition hover:bg-oro-300 hover:text-verde-950"
                  >
                    Tocar para activar audio
                  </button>
                </div>
                <video
                  data-auto-video
                  controls
                  muted
                  loop
                  playsinline
                  preload="metadata"
                  data-poster={posters[inv.nombre]}
                  aria-label={inv.videoTitulo}
                  class="mx-auto block max-h-[28rem] w-full bg-black object-contain"
                >
                  <source src={inv.videoSrc} type="video/mp4" />
                </video>
              </div>
            )}
          </li>
        ))}
      </ul>
    </div>
  </section>
)}
