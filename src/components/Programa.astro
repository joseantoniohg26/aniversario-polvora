---
import programa from '../data/programa.json';
import distrito from '../data/distrito.json';
import Ola from './Ola.astro';

const { textos } = distrito;
const meses = ['enero', 'febrero', 'marzo', 'abril', 'mayo', 'junio', 'julio', 'agosto', 'septiembre', 'octubre', 'noviembre', 'diciembre'];
const mesDe = (iso: string) => meses[Number(iso.slice(5, 7)) - 1];
---
<section id="programa" class="relative bg-crema px-4 pb-14 pt-16">
  <Ola class="text-verde-900" />
  <div class="mx-auto max-w-3xl">
    <h2 class="reveal text-4xl text-verde-900 sm:text-5xl">Programa de actividades</h2>
    <p class="reveal mt-3 text-lg">
      {distrito.textoFechas}. Los horarios son los del cronograma de la municipalidad.
      Si cambia algo, se avisa en su página de Facebook.
    </p>

    <nav id="dias-nav" aria-label={textos.programa.atajos} class="dias-nav sticky top-[3.3rem] z-30 -mx-4 mt-6 bg-crema/95 px-4 py-2.5 backdrop-blur">
      <ul class="mx-auto flex max-w-3xl gap-2">
        {programa.dias.map((d) => (
          <li class="flex-1">
            <a href={`#${d.id}`} data-dia={d.id} class:list={['chip', d.central && 'central']}>
              <span class="text-[0.72rem] font-bold uppercase tracking-wide">{d.diaSemana.slice(0, 3)}</span>
              <span class="font-display text-2xl">{d.numero}</span>
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="mt-8 space-y-12">
      {programa.dias.map((d) => (
        <article id={d.id} data-fecha={d.fecha} class="dia">
          <header
            class:list={[
              'flex items-center gap-4 rounded-t-2xl px-5 py-4 text-white',
              d.central ? 'bg-cafe-600' : 'bg-verde-900',
            ]}
          >
            <p class="font-display text-5xl leading-none text-oro-300">{d.numero}</p>
            <div>
              <h3 class="text-2xl">{d.diaSemana}</h3>
              <p class="text-sm text-white/90">{mesDe(d.fecha)} de {d.fecha.slice(0, 4)}</p>
            </div>
            <div class="ml-auto flex flex-col items-end gap-1">
              {d.central && (
                <p class="rounded-full bg-oro-300 px-3 py-1 text-sm font-bold text-verde-950">{textos.programa.etiquetaCentral}</p>
              )}
              <p class="hoy hidden rounded-full bg-white px-3 py-1 text-sm font-bold text-verde-900">{textos.programa.etiquetaHoy}</p>
            </div>
          </header>
          <ol class="divide-y divide-verde-700/15 rounded-b-2xl border-x border-b border-verde-700/20 bg-white">
            {d.actividades.map((a) => (
              <li class="fila grid grid-cols-[5.6rem_1fr] gap-x-3 px-4 py-3.5 sm:grid-cols-[8rem_1fr] sm:px-5">
                <p class="font-bold leading-tight text-verde-700">{a.hora}</p>
                <div>
                  <p class="font-bold leading-snug">{a.titulo}</p>
                  {a.detalle && <p class="text-[0.98rem] text-tinta/80">{a.detalle}</p>}
                  {a.lista && (
                    <ul class="mt-1.5 list-disc space-y-0.5 pl-5 text-[0.98rem]">
                      {a.lista.map((x) => <li>{x}</li>)}
                    </ul>
                  )}
                  {a.lugar && <p class="mt-1 text-[0.95rem] font-bold text-cafe-700">Lugar: {a.lugar}</p>}
                  {a.contacto && (
                    <p class="mt-1 text-[0.95rem]">
                      <a
                        class="font-bold text-verde-700 underline underline-offset-2"
                        href={`https://wa.me/${a.contacto.whatsapp}`}
                        rel="noopener noreferrer"
                        target="_blank"
                      >{a.contacto.texto}</a>
                    </p>
                  )}
                </div>
              </li>
            ))}
          </ol>
          {d.lema && <p class="mt-3 text-center font-display text-lg text-verde-700">{d.lema}</p>}
        </article>
      ))}
    </div>
  </div>
</section>

<script>
  // Muestra un día a la vez (el de hoy, o el próximo). Sin JavaScript se ven los cinco días seguidos.
  const seccion = document.getElementById('programa');
  if (seccion) {
    const dias = [...seccion.querySelectorAll<HTMLElement>('.dia')];
    const chips = [...seccion.querySelectorAll<HTMLElement>('[data-dia]')];
    const hoy = new Intl.DateTimeFormat('en-CA', { timeZone: 'America/Lima' }).format(new Date());

    const mostrar = (id: string) => {
      dias.forEach((d) => d.classList.toggle('activo', d.id === id));
      chips.forEach((c) => c.setAttribute('aria-current', String(c.dataset.dia === id)));
    };
    const irA = (id: string) => {
      mostrar(id);
      history.replaceState(null, '', `#${id}`);
      document.getElementById(id)?.scrollIntoView({ behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth', block: 'start' });
    };

    const delHoy = dias.find((d) => d.dataset.fecha === hoy);
    delHoy?.querySelector('.hoy')?.classList.remove('hidden');
    const proximo = dias.find((d) => (d.dataset.fecha ?? '') > hoy);
    const desdeUrl = dias.find((d) => `#${d.id}` === location.hash);
    seccion.dataset.tabs = 'on';
    mostrar((desdeUrl ?? delHoy ?? proximo ?? dias[dias.length - 1]).id);

    // Cualquier enlace a un día (chips del programa o de la portada) cambia de pestaña.
    document.addEventListener('click', (e) => {
      const a = (e.target as Element).closest<HTMLAnchorElement>('a[href^="#dia-"]');
      if (!a) return;
      e.preventDefault();
      irA(a.getAttribute('href')!.slice(1));
    });
    addEventListener('hashchange', () => {
      const id = location.hash.slice(1);
      if (dias.some((d) => d.id === id)) mostrar(id);
    });
  }
</script>
