---
import { Image, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import programa from '../data/programa.json';
import distrito from '../data/distrito.json';
import plazaFondo from '../assets/galeria/01-plaza.jpg';
import Ola from './Ola.astro';
import ReproductorFiesta from './ReproductorFiesta.astro';

const fotosActividades = import.meta.glob<{ default: ImageMetadata }>('../assets/actividades_hd/*.{jpg,jpeg,png,webp}', { eager: true });
const fotoDe = Object.fromEntries(
  Object.entries(fotosActividades).map(([ruta, m]) => [ruta.split('/').pop()!.replace(/\.[^.]+$/, ''), m.default]),
);

const galeriaFotos = import.meta.glob<{ default: ImageMetadata }>('../assets/galeria/*.{jpg,jpeg,png,webp}', { eager: true });
const galeriaDe = Object.fromEntries(
  Object.entries(galeriaFotos).map(([ruta, m]) => [ruta.split('/').pop()!.replace(/\.[^.]+$/, ''), m.default]),
);

interface Actividad {
  hora: string;
  titulo: string;
  detalle?: string;
  lugar: string | null;
  icono?: string;
  lista?: string[];
  contacto?: { texto: string; whatsapp: string };
}

const { videoIntro, textos } = distrito;
const introPosterSrc = videoIntro?.poster ? galeriaDe[videoIntro.poster] : undefined;
const introPosterUrl = introPosterSrc
  ? (await getImage({ src: introPosterSrc, width: 640, format: 'webp', quality: 60 })).src
  : undefined;

const meses = ['enero', 'febrero', 'marzo', 'abril', 'mayo', 'junio', 'julio', 'agosto', 'septiembre', 'octubre', 'noviembre', 'diciembre'];
const mesDe = (iso: string) => meses[Number(iso.slice(5, 7)) - 1];
---
<section id="programa" class="relative overflow-hidden bg-crema px-4 pb-16 pt-16">
  <Ola class="text-verde-900" />

  <!-- Fondo atmosférico en transparencia -->
  <div class="pointer-events-none absolute inset-0 z-0 overflow-hidden" aria-hidden="true">
    <Image
      src={plazaFondo}
      alt=""
      widths={[480]}
      sizes="100vw"
      format="webp"
      quality={35}
      loading="lazy"
      class="h-full w-full object-cover opacity-[0.07]"
    />
    <div class="programa-velo absolute inset-0"></div>
    <svg class="mg-flota absolute left-4 top-32 hidden h-28 w-20 text-verde-700/15 lg:block" viewBox="0 0 40 60"><use href="#hoja" /></svg>
    <svg class="mg-flota absolute right-6 top-56 hidden h-28 w-20 text-oro-500/20 lg:block" style="animation-delay:-1.4s" viewBox="0 0 40 60"><use href="#cacao" /></svg>
    <svg class="mg-flota absolute left-8 bottom-36 hidden h-24 w-16 text-oro-500/20 lg:block" style="animation-delay:-2.1s" viewBox="0 0 40 60"><use href="#cacao" /></svg>
    <svg class="mg-flota absolute right-8 bottom-24 hidden h-28 w-20 text-verde-700/15 lg:block" style="animation-delay:-0.8s" viewBox="0 0 40 60"><use href="#hoja" /></svg>
  </div>

  <div class="relative z-10 mx-auto max-w-5xl">
    <!-- Video introductorio ANTES del programa de actividades -->
    {videoIntro && (
      <div class="video-card reveal mb-10 overflow-hidden rounded-3xl border border-verde-700/25 bg-verde-950 text-white shadow-xl">
        <div class="flex flex-wrap items-center justify-between gap-2 px-4 py-3 sm:px-6">
          <div>
            <p class="text-xs font-bold uppercase tracking-widest text-oro-300">Video introductorio</p>
            <h2 class="font-display text-xl text-white sm:text-2xl">{videoIntro.titulo}</h2>
          </div>
          <button
            type="button"
            data-video-audio
            class="inline-flex items-center gap-1.5 rounded-full border border-oro-300/60 bg-black/40 px-3 py-1 text-xs font-bold text-oro-300 transition hover:bg-oro-300 hover:text-verde-950"
          >
            Tocar para activar audio
          </button>
        </div>
        <div class="relative bg-black">
          <video
            data-auto-video
            controls
            muted
            loop
            playsinline
            preload="metadata"
            poster={introPosterUrl}
            class="max-h-[460px] w-full object-contain"
          >
            <source src={videoIntro.archivo} type="video/mp4" />
          </video>
        </div>
        {videoIntro.detalle && (
          <p class="px-4 py-2.5 text-sm text-white/80 sm:px-6">{videoIntro.detalle}</p>
        )}
      </div>
    )}

    <div class="flex flex-wrap items-end justify-between gap-4">
      <div>
        <h2 class="reveal text-4xl text-verde-900 sm:text-5xl">Programa de actividades</h2>
        <p class="reveal mt-3 max-w-2xl text-lg">
          {distrito.textoFechas}. Los horarios corresponden al cronograma oficial de la municipalidad.
        </p>
      </div>
      <p class="programa-badge reveal hidden rounded-full border border-verde-700/25 bg-white/80 px-4 py-1.5 text-sm font-bold text-verde-900 shadow-sm sm:inline-block">
        42.° Aniversario · Pólvora 2026
      </p>
    </div>

    <nav id="dias-nav" aria-label={textos.programa.atajos} class="dias-nav sticky top-[3.3rem] z-30 -mx-4 mt-6 bg-crema/95 px-4 py-2.5 backdrop-blur">
      <ul class="mx-auto flex max-w-5xl gap-2">
        {programa.dias.map((d) => (
          <li class="flex-1">
            <a href={`#${d.id}`} data-dia={d.id} class:list={['chip', d.central && 'central']}>
              <span class="text-[0.72rem] font-bold uppercase tracking-wide">{d.diaSemana.slice(0, 3)}</span>
              <span class="font-display text-2xl">{d.numero}</span>
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="mt-8 space-y-12">
      {programa.dias.map((d) => {
        const banner = d.bannerFoto ? fotoDe[d.bannerFoto] : undefined;
        const card915 = d.destacado915;
        const fondo915 = card915?.fondo ? fotoDe[card915.fondo] : undefined;
        const sticker915 = card915?.sticker ? fotoDe[card915.sticker] : undefined;

        return (
          <article id={d.id} data-fecha={d.fecha} class="dia">
            <!-- Cabecera visual del día -->
            <header
              class:list={[
                'relative overflow-hidden rounded-t-3xl px-5 py-5 text-white shadow-lg sm:px-7 sm:py-6',
                d.central ? 'bg-cafe-600' : 'bg-verde-900',
              ]}
            >
              {banner && (
                <Image
                  src={banner}
                  alt=""
                  widths={[480, 800]}
                  sizes="(min-width: 1024px) 960px, 95vw"
                  format="webp"
                  quality={40}
                  loading="lazy"
                  class="pointer-events-none absolute inset-0 h-full w-full object-cover opacity-25 mix-blend-luminosity"
                />
              )}
              <div
                class:list={[
                  'pointer-events-none absolute inset-0',
                  d.central
                    ? 'bg-gradient-to-r from-cafe-700/95 via-cafe-700/92 to-cafe-700/85'
                    : 'bg-gradient-to-r from-verde-950/95 via-verde-900/85 to-verde-700/70',
                ]}
              ></div>

              <div class="relative z-10 flex flex-wrap items-center gap-4">
                <p class="font-display text-5xl leading-none text-oro-300 sm:text-6xl">{d.numero}</p>
                <div class="min-w-0 flex-1">
                  <h3 class="text-2xl sm:text-3xl">{d.diaSemana}</h3>
                  <p class="text-sm text-white/90">{mesDe(d.fecha)} de {d.fecha.slice(0, 4)}</p>
                  {d.subtitulo && <p class="mt-1 text-sm font-bold text-oro-300/95 sm:text-base">{d.subtitulo}</p>}
                </div>
                <div class="ml-auto flex items-center gap-2">
                  {d.id === 'dia-5' && (
                    <a
                      href="#reproductor-dia-5"
                      class="inline-flex items-center gap-1.5 rounded-full bg-[#1db954] px-3.5 py-1.5 text-xs font-bold text-black shadow transition hover:bg-[#1ed760]"
                    >
                      <span>Escuchar grupos abajo</span>
                    </a>
                  )}
                  <div class="flex flex-col items-end gap-1">
                    {d.central && (
                      <p class="rounded-full bg-oro-300 px-3 py-1 text-sm font-bold text-verde-950">{textos.programa.etiquetaCentral}</p>
                    )}
                    <p class="hoy hidden rounded-full bg-white px-3 py-1 text-sm font-bold text-verde-900">{textos.programa.etiquetaHoy}</p>
                  </div>
                </div>
              </div>
            </header>

            <!-- Cuerpo del día: cronograma limpio a la izquierda + 1 tarjeta vertical 9:15 destacada a la derecha -->
            <div class="grid items-start gap-6 rounded-b-3xl border-x border-b border-verde-700/20 bg-white/95 p-4 shadow-sm sm:p-6 lg:grid-cols-[1fr_20rem]">
              <ol class="divide-y divide-verde-700/15">
                {(d.actividades as Actividad[]).map((a) => (
                  <li class="fila grid gap-x-4 gap-y-1 px-2 py-3.5 sm:grid-cols-[7.2rem_1fr] sm:px-3">
                    <div class="flex items-center gap-2 sm:block">
                      <p class="font-bold leading-tight text-verde-700 sm:text-lg">{a.hora}</p>
                      {a.icono === 'camaretazos' && (
                        <span class="inline-flex items-center rounded-full bg-oro-300/35 px-2 py-0.5 text-[0.7rem] font-bold text-oro-700 sm:mt-1">
                          21 salvas
                        </span>
                      )}
                      {a.icono === 'futbol' && (
                        <span class="inline-flex items-center rounded-full bg-verde-100 px-2 py-0.5 text-[0.7rem] font-bold text-verde-900 sm:mt-1">
                          Deporte
                        </span>
                      )}
                      {a.icono === 'fiesta' && (
                        <span class="inline-flex items-center rounded-full bg-cafe-600/15 px-2 py-0.5 text-[0.7rem] font-bold text-cafe-700 sm:mt-1">
                          Estelar
                        </span>
                      )}
                    </div>

                    <div>
                      <p class="fila-titulo text-lg font-bold leading-snug text-verde-950">{a.titulo}</p>
                      {a.detalle && <p class="mt-0.5 text-[0.98rem] text-tinta/85">{a.detalle}</p>}
                      {a.lista && (
                        <ul class="mt-2 grid gap-1 text-[0.95rem] sm:grid-cols-2">
                          {a.lista.map((x) => (
                            <li class="flex items-center gap-1.5">
                              <span class="h-1.5 w-1.5 shrink-0 rounded-full bg-verde-500" aria-hidden="true"></span>
                              <span>{x}</span>
                            </li>
                          ))}
                        </ul>
                      )}
                      {a.lugar && <p class="mt-1.5 text-[0.95rem] font-bold text-cafe-700">Lugar: {a.lugar}</p>}
                      {a.contacto && (
                        <p class="mt-1 text-[0.95rem]">
                          <a
                            class="font-bold text-verde-700 underline underline-offset-2"
                            href={`https://wa.me/${a.contacto.whatsapp}`}
                            rel="noopener noreferrer"
                            target="_blank"
                          >{a.contacto.texto}</a>
                        </p>
                      )}
                    </div>
                  </li>
                ))}
              </ol>

              <!-- Tarjeta vertical única en formato 9:15 (estilo TikTok/Reels) con sticker animado -->
              {card915 && fondo915 && (
                <aside class="lg:sticky lg:top-28">
                  <div class="destacado-915 relative mx-auto aspect-[9/15] w-full max-w-[21rem] overflow-hidden rounded-3xl border-2 border-oro-500/60 bg-verde-950 text-white shadow-2xl">
                    <Image
                      src={fondo915}
                      alt={sticker915 ? '' : card915.alt}
                      widths={[400, 640]}
                      sizes="(min-width: 1024px) 320px, 85vw"
                      format="webp"
                      quality={sticker915 ? 55 : 80}
                      loading="lazy"
                      class:list={[
                        'absolute inset-0 h-full w-full object-cover',
                        sticker915 ? 'opacity-50 scale-105' : 'opacity-90',
                      ]}
                    />
                    <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-verde-950 via-verde-950/35 to-verde-950/55"></div>

                    <!-- Destellos decorativos suaves -->
                    <svg class="titila pointer-events-none absolute right-5 top-16 h-5 w-5 text-oro-300" viewBox="0 0 24 24" aria-hidden="true"><use href="#estrella" /></svg>
                    <svg class="titila pointer-events-none absolute left-5 top-28 h-4 w-4 text-oro-300" style="animation-delay:-1.1s" viewBox="0 0 24 24" aria-hidden="true"><use href="#estrella" /></svg>

                    {sticker915 && (
                      <div class="pointer-events-none absolute inset-x-0 bottom-20 top-12 flex items-end justify-center px-4">
                        <div class="relative flex h-full w-full items-end justify-center">
                          <span class="halo opacity-60" aria-hidden="true"></span>
                          <Image
                            src={sticker915}
                            alt={card915.alt}
                            widths={[340, 520]}
                            sizes="300px"
                            format="webp"
                            quality={85}
                            loading="lazy"
                            class="flota relative max-h-full w-auto object-contain drop-shadow-[0_14px_26px_rgba(0,0,0,0.65)]"
                          />
                        </div>
                      </div>
                    )}

                    <div class="relative z-10 flex h-full flex-col justify-between p-5">
                      <div class="flex items-center justify-between gap-2">
                        <span class="rounded-full bg-oro-300 px-3 py-1 text-xs font-bold text-verde-950 shadow">
                          {card915.badge}
                        </span>
                        {card915.efecto === 'futbol' && (
                          <span class="mg-rebote grid h-10 w-10 place-items-center rounded-full bg-white/15 text-oro-300 backdrop-blur-sm" aria-hidden="true">
                            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                              <circle cx="12" cy="12" r="9" />
                              <path d="M12 7l3 2.2-1.1 3.5H10.1L9 9.2z" />
                            </svg>
                          </span>
                        )}
                        {card915.efecto === 'central' && (
                          <span class="mg-onda grid h-10 w-10 place-items-center rounded-full bg-white/15 text-oro-300 backdrop-blur-sm" aria-hidden="true">
                            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                              <path d="M5 3v18M5 4h12l-2 4 2 4H5" />
                            </svg>
                          </span>
                        )}
                      </div>

                      <div>
                        <p class="font-display text-2xl leading-tight text-white drop-shadow">{card915.titulo}</p>
                        {card915.nota && (
                          <p class="mt-1.5 text-sm font-bold text-oro-300 drop-shadow">{card915.nota}</p>
                        )}
                      </div>
                    </div>
                  </div>
                </aside>
              )}
            </div>

            {d.tieneReproductor && <ReproductorFiesta />}

            {d.lema && <p class="mt-4 text-center font-display text-xl text-verde-700">{d.lema}</p>}
          </article>
        );
      })}
    </div>
  </div>
</section>

<script>
  const seccion = document.getElementById('programa');
  if (seccion) {
    const dias = [...seccion.querySelectorAll<HTMLElement>('.dia')];
    const chips = [...seccion.querySelectorAll<HTMLElement>('[data-dia]')];
    const hoy = new Intl.DateTimeFormat('en-CA', { timeZone: 'America/Lima' }).format(new Date());

    const mostrar = (id: string) => {
      dias.forEach((d) => d.classList.toggle('activo', d.id === id));
      chips.forEach((c) => c.setAttribute('aria-current', String(c.dataset.dia === id)));
      window.dispatchEvent(new CustomEvent('polvora:cambio-vista'));
    };

    const irA = (id: string) => {
      window.dispatchEvent(new CustomEvent('polvora:ir-vista', { detail: { vista: 'programa', subId: id } }));
      mostrar(id);
      history.replaceState(null, '', `#${id}`);
      setTimeout(() => {
        document.getElementById(id)?.scrollIntoView({
          behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth',
          block: 'start',
        });
      }, 40);
    };

    const delHoy = dias.find((d) => d.dataset.fecha === hoy);
    delHoy?.querySelector('.hoy')?.classList.remove('hidden');
    const proximo = dias.find((d) => (d.dataset.fecha ?? '') > hoy);
    const desdeUrl = dias.find((d) => `#${d.id}` === location.hash);
    seccion.dataset.tabs = 'on';
    mostrar((desdeUrl ?? delHoy ?? proximo ?? dias[dias.length - 1]).id);

    document.addEventListener('click', (e) => {
      const a = (e.target as Element).closest<HTMLAnchorElement>('a[href^="#dia-"]');
      if (!a) return;
      e.preventDefault();
      irA(a.getAttribute('href')!.slice(1));
    });
    addEventListener('hashchange', () => {
      const id = location.hash.slice(1);
      if (dias.some((d) => d.id === id)) mostrar(id);
    });
  }
</script>
