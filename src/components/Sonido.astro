---
// Modo noche flotante + Salva de 21 camaretazos en la portada (sin sonidos intrusivos en actividades)
---
<button
  id="modo-noche"
  type="button"
  class="modo-noche-btn"
  aria-pressed="false"
  aria-label="Cambiar a modo noche"
  title="Cambiar entre modo día y modo noche"
>
  <svg class="ico-luna" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
  </svg>
  <svg class="ico-sol" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41" />
  </svg>
</button>

<audio id="sfx-salva" preload="none" src="/audio/camaretazos.m4a"></audio>

<script>
  // ───────── 1. Modo Noche persistente ─────────
  const btnNoche = document.getElementById('modo-noche') as HTMLButtonElement | null;
  const txtNoche = btnNoche?.querySelector('[data-noche-txt]');
  const aplicarNoche = (on: boolean) => {
    document.documentElement.classList.toggle('noche', on);
    if (btnNoche) {
      btnNoche.setAttribute('aria-pressed', String(on));
      btnNoche.setAttribute('aria-label', on ? 'Cambiar a modo día' : 'Cambiar a modo noche');
    }
    if (txtNoche) txtNoche.textContent = on ? 'Modo día' : 'Modo noche';
  };
  try {
    if (localStorage.getItem('polvora-modo-noche') === '1') aplicarNoche(true);
  } catch {}
  btnNoche?.addEventListener('click', () => {
    const siguiente = !document.documentElement.classList.contains('noche');
    aplicarNoche(siguiente);
    try { localStorage.setItem('polvora-modo-noche', siguiente ? '1' : '0'); } catch {}
  });

  // ───────── 2. Salva de 21 camaretazos en la portada (#salva) ─────────
  const salva = document.getElementById('salva') as HTMLButtonElement | null;
  const sfxSalva = document.getElementById('sfx-salva') as HTMLAudioElement | null;
  salva?.classList.remove('invisible');

  const detenerSalva = () => {
    if (sfxSalva && !sfxSalva.paused) sfxSalva.pause();
  };
  window.addEventListener('polvora:spotify-play', detenerSalva);
  window.addEventListener('polvora:video-audio-on', detenerSalva);

  salva?.addEventListener('click', () => {
    window.dispatchEvent(new CustomEvent('polvora:sfx-play'));
    document.querySelectorAll<HTMLVideoElement>('video').forEach((v) => {
      if (!v.muted) {
        v.muted = true;
        v.dispatchEvent(new CustomEvent('polvora:sync-mute'));
      }
    });
    if (sfxSalva) {
      sfxSalva.currentTime = 0;
      void sfxSalva.play().catch(() => {});
    }

    const reducido = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const capa = document.querySelector('#inicio .fiesta');
    const colores = ['#efd488', '#ff8a7a', '#7de0b4', '#6cc4ff'];
    const etiqueta = salva.textContent ?? '';
    salva.disabled = true;
    let n = 0;
    const siguiente = () => {
      n++;
      salva.textContent = `${n} / 21`;
      if (capa && !reducido) {
        const svg = document.createElementNS('http://www.w3.org/2000/svg', 'svg');
        svg.setAttribute('viewBox', '-50 -50 100 100');
        svg.setAttribute('class', 'destello');
        const tam = 90 + Math.random() * 90;
        svg.style.cssText = `width:${tam}px;height:${tam}px;left:${Math.random() * 85}%;top:${Math.random() * 70}%;color:${colores[n % 4]}`;
        const uso = document.createElementNS('http://www.w3.org/2000/svg', 'use');
        uso.setAttribute('href', '#estallido');
        svg.appendChild(uso);
        svg.addEventListener('animationend', () => svg.remove());
        capa.appendChild(svg);
      }
      if (n < 21) setTimeout(siguiente, 160 + Math.random() * 260);
      else setTimeout(() => { salva.textContent = etiqueta; salva.disabled = false; }, 1500);
    };
    siguiente();
  });
</script>
