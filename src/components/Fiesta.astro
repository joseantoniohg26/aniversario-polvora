---
// Capa decorativa de la portada: solo cacao y hojas que caen, muy tenues.
// La «Salva de 21 camaretazos» agrega los destellos sobre esta misma capa.
const lluvia = [
  { t: 'cacao', l: 8, s: 24, dur: 18, del: -3, c: '#e39a2d', dx: 24, g: 16 },
  { t: 'hoja', l: 22, s: 22, dur: 15, del: -9, c: '#2fae7d', dx: -18, g: 22 },
  { t: 'cacao', l: 41, s: 26, dur: 20, del: -12, c: '#efd488', dx: 16, g: 14 },
  { t: 'hoja', l: 60, s: 24, dur: 16, del: -5, c: '#2fae7d', dx: 22, g: 20 },
  { t: 'cacao', l: 78, s: 22, dur: 19, del: -8, c: '#e39a2d', dx: -20, g: 12 },
  { t: 'hoja', l: 92, s: 22, dur: 17, del: -14, c: '#7de0b4', dx: -14, g: 24 },
];
---
<div class="fiesta pointer-events-none absolute inset-0 z-0 overflow-hidden" aria-hidden="true">
  {lluvia.map((p, i) => (
    <div
      class:list={['cae absolute top-0', i > 3 && 'hidden sm:block']}
      style={`left:${p.l}%;animation-duration:${p.dur}s;animation-delay:${p.del}s;--dx:${p.dx}px`}
    >
      <svg class="balanceo" style={`width:${p.s}px;height:${p.s * 1.5}px;color:${p.c};--g:${p.g}deg;animation-duration:${(p.dur / 3).toFixed(1)}s`} viewBox="0 0 40 60"><use href={`#${p.t}`} /></svg>
    </div>
  ))}
</div>
