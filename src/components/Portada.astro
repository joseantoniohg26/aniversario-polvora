---
import { Image } from 'astro:assets';
import escudo from '../assets/escudo.webp';
import Bunting from './Bunting.astro';
import Luces from './Luces.astro';
import Fiesta from './Fiesta.astro';
import distrito from '../data/distrito.json';
import programa from '../data/programa.json';

const { aniversario, fechaCentral, zonaHoraria, textoFechas, textos } = distrito;
const objetivo = `${fechaCentral}T00:00:00${zonaHoraria}`;
---
<section id="inicio" class="fondo-portada relative overflow-hidden text-center text-white">
  <Fiesta />
  <div class="relative z-10">
    <Bunting class="block" />
    <Luces class="-mt-1 block" />
  </div>

  <div class="relative z-10 mx-auto max-w-3xl px-5 pb-24 pt-5">
    <div class="entra relative mx-auto w-fit" style="--d:0s">
      <span class="halo" aria-hidden="true"></span>
      <Image
        src={escudo}
        alt={`Escudo de la ${distrito.municipalidad.nombre}`}
        width={240}
        height={198}
        class="flota relative mx-auto h-auto w-44 rounded-2xl bg-white/95 p-3 shadow-xl sm:w-56"
        loading="eager"
        fetchpriority="high"
      />
    </div>
    <p class="entra mt-6 text-lg font-bold uppercase tracking-wide text-oro-300" style="--d:.15s">{textos.portada.etiqueta}</p>
    <h1 class="mt-1 text-oro-300">
      <span class="entra brillo block text-[5.5rem] leading-none sm:text-[8rem]" style="--d:.3s">{aniversario}.°</span>
      <span class="entra block text-4xl text-white sm:text-6xl" style="--d:.45s">Aniversario</span>
    </h1>
    <p class="entra mt-4 text-xl font-bold" style="--d:.6s">{textoFechas}</p>
    <p class="entra mt-1 text-white/85" style="--d:.7s">{textos.portada.diaCentral}</p>

    <div
      id="contador"
      hidden
      data-objetivo={objetivo}
      data-textos={JSON.stringify(textos.contador)}
      class="entra mx-auto mt-8 max-w-xs rounded-2xl border border-oro-500/60 bg-verde-950/70 px-5 py-4 [&:not([hidden])]:block"
      style="--d:.85s"
    >
      <p class="text-sm font-bold uppercase tracking-wider text-oro-300">{textos.contador.faltan}</p>
      <p class="font-display text-5xl text-white" aria-live="polite"><span class="latido inline-block" data-dias></span></p>
      <p class="text-sm text-white/80" data-unidad></p>
    </div>

    <a
      href="#programa"
      class="entra boton-oro mt-8 inline-block rounded-full bg-oro-300 px-7 py-3 text-lg font-bold text-verde-950 shadow-lg"
      style="--d:1s"
    >{textos.portada.botonPrograma}</a>

    <div class="entra mt-7" style="--d:1.15s">
      <p class="text-sm font-bold uppercase tracking-wide text-oro-300">{textos.portada.verDia}</p>
      <ul class="mt-2 flex justify-center gap-2">
        {programa.dias.map((d) => (
          <li>
            <a
              href={`#${d.id}`}
              class="atajo-dia grid h-14 w-12 place-items-center rounded-xl border border-oro-300/60 bg-verde-950/50 leading-none sm:w-14"
            >
              <span class="text-[0.7rem] font-bold uppercase">{d.diaSemana.slice(0, 3)}</span>
              <span class="font-display text-xl">{d.numero}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>

    <button
      id="salva"
      type="button"
      hidden
      class="entra salva mt-7 [&:not([hidden])]:inline-flex"
      style="--d:1.3s"
    >{textos.sonido.salva}</button>
  </div>
</section>

<script>
  // Solo calcula los días que faltan. Sin JavaScript, la página muestra igual las fechas.
  const caja = document.getElementById('contador');
  if (caja) {
    const objetivo = new Date(caja.dataset.objetivo ?? '').getTime();
    const t = JSON.parse(caja.dataset.textos ?? '{}');
    const dias = Math.ceil((objetivo - Date.now()) / 86400000);
    const num = caja.querySelector('[data-dias]');
    const unidad = caja.querySelector('[data-unidad]');
    if (num && unidad && !Number.isNaN(dias)) {
      caja.hidden = false;
      if (dias > 1) { num.textContent = String(dias); unidad.textContent = t.plural; }
      else if (dias === 1) { num.textContent = '1'; unidad.textContent = t.singular; }
      else if (dias === 0) { num.textContent = t.hoy; unidad.textContent = t.hoyUnidad; }
      else { num.textContent = t.despues; unidad.textContent = t.despuesUnidad; }
    }
  }
</script>
