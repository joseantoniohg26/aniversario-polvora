---
import { Image } from 'astro:assets';
import escudo from '../assets/escudo-sticker.png';
import fondo from '../assets/galeria/01-plaza.jpg';
import Bunting from './Bunting.astro';
import Fiesta from './Fiesta.astro';
import distrito from '../data/distrito.json';

const { aniversario, fechaCentral, zonaHoraria, textoFechas, textos } = distrito;
const objetivo = `${fechaCentral}T00:00:00${zonaHoraria}`;
---
<section id="inicio" class="relative isolate overflow-hidden bg-verde-950 text-center text-white">
  <!-- La foto real de la plaza es el momento principal; lo demás queda quieto sobre ella -->
  <Image
    src={fondo}
    alt=""
    widths={[480, 800, 1280, 1800]}
    sizes="100vw"
    format="webp"
    quality={50}
    loading="eager"
    fetchpriority="high"
    class="absolute inset-0 -z-20 h-full w-full object-cover"
  />
  <div class="absolute inset-0 -z-10 bg-verde-950/76"></div>
  <div class="absolute inset-x-0 bottom-0 -z-10 h-2/5 bg-gradient-to-t from-verde-950 to-transparent"></div>

  <Fiesta />
  <Bunting class="relative z-10 block" />

  <div class="relative z-10 mx-auto max-w-3xl px-5 pb-28 pt-8 sm:pt-12">
    <div class="entra mx-auto w-fit" style="--d:0s">
      <Image
        src={escudo}
        alt={`Escudo de la ${distrito.municipalidad.nombre}`}
        width={240}
        height={196}
        class="mx-auto h-auto w-40 drop-shadow-[0_10px_20px_rgba(0,0,0,0.5)] sm:w-52"
        loading="eager"
      />
    </div>
    <p class="entra mt-6 text-lg font-bold text-oro-300" style="--d:.12s">{textos.portada.etiqueta}</p>
    <h1 class="mt-1">
      <span class="entra block font-display text-[6rem] leading-none text-oro-300 sm:text-[9rem]" style="--d:.24s">{aniversario}<span class="ord">º</span></span>
      <span class="entra mt-1 block font-display text-4xl sm:text-6xl" style="--d:.36s">Aniversario</span>
    </h1>
    <p class="entra mt-5 text-xl font-bold" style="--d:.48s">{textoFechas}</p>
    <p class="entra mt-1 text-white" style="--d:.56s">{textos.portada.diaCentral}</p>

    <div
      id="contador"
      data-objetivo={objetivo}
      data-textos={JSON.stringify(textos.contador)}
      class="entra mx-auto mt-8 w-full max-w-[16rem] rounded-2xl border border-white/25 bg-verde-950/60 px-5 py-4 invisible"
      style="--d:.68s"
    >
      <p class="text-sm font-bold text-oro-300">{textos.contador.faltan}</p>
      <p class="font-display text-5xl tabular-nums text-white" aria-live="polite"><span data-dias>0</span></p>
      <p class="text-sm text-white/85" data-unidad>{textos.contador.plural}</p>
    </div>

    <div class="entra mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row" style="--d:.8s">
      <a
        href="#programa"
        class="boton-oro inline-block rounded-full bg-oro-300 px-7 py-3 text-lg font-bold text-verde-950"
      >{textos.portada.botonPrograma}</a>
      <button
        id="salva"
        type="button"
        class="salva invisible inline-flex"
      >{textos.sonido.salva}</button>
    </div>
  </div>
</section>

<script>
  // Solo calcula los días que faltan. Sin JavaScript, la página muestra igual las fechas.
  const caja = document.getElementById('contador');
  if (caja) {
    const objetivo = new Date(caja.dataset.objetivo ?? '').getTime();
    const t = JSON.parse(caja.dataset.textos ?? '{}');
    const dias = Math.ceil((objetivo - Date.now()) / 86400000);
    const num = caja.querySelector('[data-dias]');
    const unidad = caja.querySelector('[data-unidad]');
    if (num && unidad && !Number.isNaN(dias)) {
      caja.classList.remove('invisible');
      if (dias > 1) { num.textContent = String(dias); unidad.textContent = t.plural; }
      else if (dias === 1) { num.textContent = '1'; unidad.textContent = t.singular; }
      else if (dias === 0) { num.textContent = t.hoy; unidad.textContent = t.hoyUnidad; }
      else { num.textContent = t.despues; unidad.textContent = t.despuesUnidad; }
    }
  }
</script>
