---
import distrito from '../data/distrito.json';
import Ola from './Ola.astro';
const { ubicacion, contacto, textos } = distrito;
const t = textos.ubicacion;
const d = 0.045;
const bbox = [ubicacion.lng - d, ubicacion.lat - d * 0.7, ubicacion.lng + d, ubicacion.lat + d * 0.7].join('%2C');
const osm = `https://www.openstreetmap.org/export/embed.html?bbox=${bbox}&layer=mapnik&marker=${ubicacion.lat}%2C${ubicacion.lng}`;
---
<section id="ubicacion" class="relative bg-verde-900 px-4 pb-14 pt-16 text-white">
  <Ola class="text-crema" />
  <div class="mx-auto grid max-w-5xl gap-10 md:grid-cols-2">
    <div class="reveal">
      <h2 class="text-4xl text-oro-300 sm:text-5xl">{t.tituloLlegar}</h2>
      <p class="mt-4 text-lg">{ubicacion.texto}</p>
      <a
        href={ubicacion.mapsUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="mt-5 inline-block rounded-full bg-oro-300 px-6 py-3 font-bold text-verde-950 hover:bg-white"
      >{t.botonMaps}</a>

      <details class="mt-6 rounded-2xl border border-oro-500/60 bg-verde-950/60">
        <summary class="cursor-pointer list-none px-5 py-4 text-lg font-bold">
          {t.verMapa} <span class="font-normal text-white/80">{t.verMapaNota}</span>
        </summary>
        <iframe
          title={t.tituloMapa}
          src={osm}
          loading="lazy"
          referrerpolicy="no-referrer"
          class="h-72 w-full rounded-b-2xl border-0 bg-white"
        ></iframe>
      </details>
    </div>

    <div class="reveal" style="--i:2">
      <h2 class="text-4xl text-oro-300 sm:text-5xl">{t.tituloContacto}</h2>
      <p class="mt-4 text-lg">{t.introContacto}</p>
      <ul class="mt-4 space-y-3">
        {contacto.whatsapp.map((w) => (
          <li>
            <a
              href={`https://wa.me/${w.wa}`}
              target="_blank"
              rel="noopener noreferrer"
              class="group flex items-center gap-4 rounded-2xl border border-white/30 px-5 py-3.5 transition-colors hover:border-oro-300/60 hover:bg-white/10"
            >
              <span class="grid h-11 w-11 shrink-0 place-items-center rounded-xl bg-emerald-500/20 text-emerald-300 ring-1 ring-emerald-400/35 transition-transform group-hover:scale-105" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor">
                  <path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm5.6 14.1c-.2.7-1.4 1.3-1.9 1.3-.5 0-1.1.2-3.7-.8-3.1-1.2-5.1-4.3-5.3-4.5-.2-.2-1.3-1.7-1.3-3.2s.8-2.3 1.1-2.6c.3-.3.6-.4.8-.4h.6c.2 0 .5 0 .7.6.3.6.9 2.2 1 2.4.1.2.1.4 0 .6-.1.2-.2.3-.4.5l-.5.6c-.2.2-.3.4-.1.7.2.4.8 1.4 1.8 2.2 1.2 1.1 2.3 1.4 2.7 1.6.3.1.6.1.8-.1.2-.3.9-1 1.1-1.4.2-.3.5-.3.8-.2.3.1 2 .9 2.3 1.1.3.2.6.3.7.4.1.2.1.8-.1 1.4Z" />
                </svg>
              </span>
              <span class="min-w-0">
                <span class="block text-sm text-white/80">{w.etiqueta}</span>
                <span class="text-xl font-bold">WhatsApp {w.numero}</span>
              </span>
            </a>
          </li>
        ))}
        {contacto.redes.map((r) => {
          const esFacebook = r.url.includes('facebook') || r.etiqueta.toLowerCase().includes('facebook');
          return (
            <li>
              <a
                href={r.url}
                target="_blank"
                rel="noopener noreferrer"
                class="group flex items-center gap-4 rounded-2xl border border-white/30 px-5 py-3.5 transition-colors hover:border-oro-300/60 hover:bg-white/10"
              >
                <span
                  class:list={[
                    'grid h-11 w-11 shrink-0 place-items-center rounded-xl ring-1 transition-transform group-hover:scale-105',
                    esFacebook ? 'bg-sky-500/20 text-sky-300 ring-sky-400/35' : 'bg-oro-300/15 text-oro-300 ring-oro-300/35',
                  ]}
                  aria-hidden="true"
                >
                  {esFacebook ? (
                    <svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor">
                      <path d="M13.5 22v-8h2.7l.4-3h-3.1V9.1c0-.9.3-1.5 1.6-1.5h1.6V5a21 21 0 0 0-2.4-.1c-2.4 0-4 1.5-4 4.1V11H7.6v3h2.7v8h3.2Z" />
                    </svg>
                  ) : (
                    <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
                      <circle cx="12" cy="12" r="9.5" />
                      <path d="M2.8 9.5h18.4M2.8 14.5h18.4M12 2.5a13.5 13.5 0 0 1 0 19M12 2.5a13.5 13.5 0 0 0 0 19" />
                    </svg>
                  )}
                </span>
                <span class="min-w-0 text-xl font-bold">{r.etiqueta}</span>
              </a>
            </li>
          );
        })}
      </ul>
    </div>
  </div>
</section>
