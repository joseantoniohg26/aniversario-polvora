---
import distrito from '../data/distrito.json';
import Ola from './Ola.astro';
const { ubicacion, contacto, textos } = distrito;
const t = textos.ubicacion;
const d = 0.045;
const bbox = [ubicacion.lng - d, ubicacion.lat - d * 0.7, ubicacion.lng + d, ubicacion.lat + d * 0.7].join('%2C');
const osm = `https://www.openstreetmap.org/export/embed.html?bbox=${bbox}&layer=mapnik&marker=${ubicacion.lat}%2C${ubicacion.lng}`;
---
<section id="ubicacion" class="relative bg-verde-900 px-4 pb-14 pt-16 text-white">
  <Ola class="text-crema" />
  <div class="mx-auto grid max-w-5xl gap-10 md:grid-cols-2">
    <div class="reveal">
      <h2 class="text-4xl text-oro-300 sm:text-5xl">{t.tituloLlegar}</h2>
      <p class="mt-4 text-lg">{ubicacion.texto}</p>
      <a
        href={ubicacion.mapsUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="mt-5 inline-block rounded-full bg-oro-300 px-6 py-3 font-bold text-verde-950 hover:bg-white"
      >{t.botonMaps}</a>

      <details class="mt-6 rounded-2xl border border-oro-500/60 bg-verde-950/60">
        <summary class="cursor-pointer list-none px-5 py-4 text-lg font-bold">
          {t.verMapa} <span class="font-normal text-white/80">{t.verMapaNota}</span>
        </summary>
        <iframe
          title={t.tituloMapa}
          src={osm}
          loading="lazy"
          referrerpolicy="no-referrer"
          class="h-72 w-full rounded-b-2xl border-0 bg-white"
        ></iframe>
      </details>
    </div>

    <div class="reveal" style="--i:2">
      <h2 class="text-4xl text-oro-300 sm:text-5xl">{t.tituloContacto}</h2>
      <p class="mt-4 text-lg">{t.introContacto}</p>
      <ul class="mt-4 space-y-3">
        {contacto.whatsapp.map((w) => (
          <li>
            <a
              href={`https://wa.me/${w.wa}`}
              target="_blank"
              rel="noopener noreferrer"
              class="block rounded-2xl border border-white/30 px-5 py-3 hover:bg-white/10"
            >
              <span class="block text-sm text-white/80">{w.etiqueta}</span>
              <span class="text-xl font-bold">WhatsApp {w.numero}</span>
            </a>
          </li>
        ))}
        {contacto.redes.map((r) => (
          <li>
            <a
              href={r.url}
              target="_blank"
              rel="noopener noreferrer"
              class="block rounded-2xl border border-white/30 px-5 py-3 text-xl font-bold hover:bg-white/10"
            >{r.etiqueta}</a>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>
