---
import { Image } from 'astro:assets';
import gobpe from '../assets/iconos/gobpe-escudo.png';
import whatsappSvg from '../assets/iconos/whatsapp.svg?raw';
import facebookSvg from '../assets/iconos/facebook.svg?raw';
import distrito from '../data/distrito.json';
import Ola from './Ola.astro';

const { ubicacion, contacto, textos } = distrito;
const t = textos.ubicacion;
// Logos oficiales (WhatsApp y Facebook: Simple Icons, CC0; Gob.pe: el escudo que publica su propio portal)
const sinTitulo = (svg: string) => svg.replace(/<title>[\s\S]*?<\/title>/, '');
const d = 0.045;
const bbox = [ubicacion.lng - d, ubicacion.lat - d * 0.7, ubicacion.lng + d, ubicacion.lat + d * 0.7].join('%2C');
const osm = `https://www.openstreetmap.org/export/embed.html?bbox=${bbox}&layer=mapnik&marker=${ubicacion.lat}%2C${ubicacion.lng}`;

// Una sola lista para todos los medios de contacto: el logo cambia, el diseño no.
interface Red { red?: string; descripcion?: string; etiqueta: string; url: string; icono?: string }
const filas = [
  ...contacto.whatsapp.map((w) => ({
    icono: 'whatsapp',
    href: `https://wa.me/${w.wa}`,
    rotulo: w.etiqueta,
    valor: `WhatsApp ${w.numero}`,
  })),
  ...(contacto.redes as Red[]).map((r) => ({
    icono: r.icono ?? 'web',
    href: r.url,
    rotulo: r.red ?? 'Redes',
    valor: r.descripcion ?? r.etiqueta,
  })),
];
---
<section id="ubicacion" class="relative bg-verde-900 px-4 pb-14 pt-16 text-white">
  <Ola class="text-crema" />
  <div class="mx-auto grid max-w-5xl gap-10 md:grid-cols-2">
    <div class="reveal">
      <h2 class="text-4xl text-oro-300 sm:text-5xl">{t.tituloLlegar}</h2>
      <p class="mt-4 text-lg">{ubicacion.texto}</p>
      <a
        href={ubicacion.mapsUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="mt-5 inline-block rounded-full bg-oro-300 px-6 py-3 font-bold text-verde-950 hover:bg-white"
      >{t.botonMaps}</a>

      <details class="mt-6 rounded-2xl border border-oro-500/60 bg-verde-950/60">
        <summary class="cursor-pointer list-none px-5 py-4 text-lg font-bold">
          {t.verMapa} <span class="font-normal text-white/80">{t.verMapaNota}</span>
        </summary>
        <iframe
          title={t.tituloMapa}
          src={osm}
          loading="lazy"
          referrerpolicy="no-referrer"
          class="h-72 w-full rounded-b-2xl border-0 bg-white"
        ></iframe>
      </details>
    </div>

    <div class="reveal" style="--i:2">
      <h2 class="text-4xl text-oro-300 sm:text-5xl">{t.tituloContacto}</h2>
      <p class="mt-4 text-lg">{t.introContacto}</p>

      <!-- Directorio: filas separadas por una línea fina, cada una con su logo -->
      <ul class="mt-5 border-b border-oro-300/25">
        {filas.map((f) => (
          <li class="border-t border-oro-300/25">
            <a
              href={f.href}
              target="_blank"
              rel="noopener noreferrer"
              class="fila-contacto group flex items-center gap-4 px-1 py-4"
            >
              <span class:list={['logo', `logo-${f.icono}`]} aria-hidden="true">
                {f.icono === 'whatsapp' && <Fragment set:html={sinTitulo(whatsappSvg)} />}
                {f.icono === 'facebook' && <Fragment set:html={sinTitulo(facebookSvg)} />}
                {f.icono === 'gobpe' && <Image src={gobpe} alt="" width={104} height={104} loading="lazy" />}
              </span>
              <span class="min-w-0 flex-1">
                <span class="block text-sm text-white/80">{f.rotulo}</span>
                <span class="block font-display text-xl leading-snug">{f.valor}</span>
              </span>
              <svg class="flecha-contacto h-5 w-5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l6 6-6 6" /></svg>
              <span class="sr-only">(se abre en otra pestaña)</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>
