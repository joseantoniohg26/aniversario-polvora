---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import distrito from '../data/distrito.json';
import Ola from './Ola.astro';

const fotosHistoria = import.meta.glob<{ default: ImageMetadata }>('../assets/historia/*.{jpg,jpeg,png,webp}', { eager: true });
const porNombre = Object.fromEntries(
  Object.entries(fotosHistoria).map(([ruta, m]) => [ruta.split('/').pop()!.replace(/\.[^.]+$/, ''), m.default]),
);

const { historia, datos } = distrito;
const imagenes = (historia.imagenes ?? []).filter((img) => porNombre[img.archivo]);
---
<section id="historia" class="relative overflow-hidden bg-verde-100 px-4 pb-16 pt-16">
  <Ola class="text-crema" />

  <div class="mx-auto max-w-5xl">
    <div class="grid gap-10 md:grid-cols-[1.2fr_1fr]">
      <div class="reveal">
        <h2 class="text-4xl text-verde-900 sm:text-5xl">{historia.titulo}</h2>
        <div class="mt-5 space-y-4 text-lg">
          {historia.parrafos.map((p) => <p>{p}</p>)}
        </div>
        <p class="mt-5 text-sm text-tinta/75">Fuentes: {historia.fuentes}</p>
      </div>

      <aside aria-labelledby="datos-titulo" class="reveal self-start rounded-2xl border-2 border-verde-700 bg-white p-5 shadow-sm" style="--i:2">
        <h3 id="datos-titulo" class="text-2xl text-verde-900">Datos del distrito</h3>
        <dl class="mt-3 divide-y divide-verde-700/15">
          {datos.map((d) => (
            <div class="py-2.5">
              <dt class="text-sm font-bold text-cafe-700">{d.etiqueta}</dt>
              <dd class="text-lg font-bold">{d.valor}{d.nota && <span class="block text-sm font-normal text-tinta/75">{d.nota}</span>}</dd>
            </div>
          ))}
        </dl>
      </aside>
    </div>

    {imagenes.length > 0 && (
      <div class="reveal mt-10 grid gap-6 sm:grid-cols-2" style="--i:3">
        {imagenes.map((img) => (
          <figure class="foto group relative overflow-hidden rounded-2xl border-2 border-verde-700/25 bg-white shadow-md">
            <div class="relative overflow-hidden">
              <Image
                src={porNombre[img.archivo]}
                alt={img.alt}
                widths={[480, 800]}
                sizes="(min-width: 640px) 46vw, 92vw"
                format="webp"
                quality={75}
                loading="lazy"
                class="h-56 w-full object-cover sm:h-64"
              />
              <!-- Ola animada en la parte baja de la foto del río -->
              <div class="pointer-events-none absolute inset-x-0 bottom-0 h-6 overflow-hidden opacity-90" aria-hidden="true">
                <svg class="rio-onda h-full w-[200%]" viewBox="0 0 1200 40" preserveAspectRatio="none">
                  <path d="M0 20 Q 150 0 300 20 T 600 20 T 900 20 T 1200 20 V 40 H 0 Z" fill="rgba(255,255,255,0.92)" />
                </svg>
              </div>
            </div>
            <figcaption class="bg-white px-4 py-3 text-base font-bold text-verde-900">{img.pie}</figcaption>
          </figure>
        ))}
      </div>
    )}
  </div>
</section>
