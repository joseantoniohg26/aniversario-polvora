---
import { Image } from 'astro:assets';
import alcalde from '../assets/alcalde-hugo.png';
import distrito from '../data/distrito.json';
import Bunting from './Bunting.astro';
const { desarrollador, municipalidad, contacto } = distrito;
---
<footer class="bg-verde-950 text-white">
  <Bunting class="block" />
  <div class="reveal mx-auto max-w-5xl px-4 py-10">
    <div class="flex flex-col items-center gap-6 sm:flex-row sm:items-end sm:gap-8">
      <Image
        src={alcalde}
        alt={`Alcalde ${municipalidad.alcalde}`}
        width={220}
        height={262}
        format="webp"
        quality={85}
        loading="lazy"
        class="h-36 w-auto shrink-0 drop-shadow-[0_10px_20px_rgba(0,0,0,0.5)] sm:h-44"
      />
      <div class="text-center sm:text-left">
        <p class="font-display text-2xl text-oro-300">{municipalidad.nombre}</p>
        <p class="mt-1 text-lg font-bold">Alcalde: {municipalidad.alcalde}</p>
        <p class="text-sm text-white/85">Gestión municipal 2023–2026</p>
        <ul class="mt-4 flex flex-wrap justify-center gap-x-5 gap-y-1 text-[0.95rem] sm:justify-start">
          {contacto.redes.map((r) => (
            <li>
              <a href={r.url} target="_blank" rel="noopener noreferrer" class="font-bold underline underline-offset-4 hover:text-oro-300">{r.etiqueta}</a>
            </li>
          ))}
        </ul>
      </div>
    </div>
    <p class="mt-8 border-t border-white/15 pt-4 text-center text-sm text-white/85 sm:text-left">
      Sitio hecho por
      <a
        href={desarrollador.url}
        target="_blank"
        rel="noopener noreferrer"
        class="font-bold text-white underline underline-offset-2"
      >{desarrollador.nombre}</a>
    </p>
  </div>
</footer>
