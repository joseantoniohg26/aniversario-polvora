---
import distrito from '../data/distrito.json';
import Bunting from './Bunting.astro';
const { desarrollador, municipalidad } = distrito;
---
<footer class="bg-verde-950 text-white">
  <Bunting class="block" />
  <div class="reveal mx-auto max-w-5xl px-4 py-8 text-center">
    <p class="font-display text-xl text-oro-300">{municipalidad.nombre}</p>
    <p class="mt-1 text-white/85">Alcalde: {municipalidad.alcalde}</p>
    <p class="mt-5 text-sm text-white/80">
      Sitio hecho por
      <a
        href={desarrollador.url}
        target="_blank"
        rel="noopener noreferrer"
        class="font-bold text-white underline underline-offset-2"
      >{desarrollador.nombre}</a>
    </p>
  </div>
</footer>
