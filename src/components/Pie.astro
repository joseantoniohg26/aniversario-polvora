---
import { Image } from 'astro:assets';
import alcalde from '../assets/alcalde-hugo.png';
import distrito from '../data/distrito.json';
import Bunting from './Bunting.astro';
const { desarrollador, municipalidad } = distrito;
---
<footer class="bg-verde-950 text-white">
  <Bunting class="block" />
  <div class="reveal mx-auto max-w-5xl px-4 py-10">
    <div class="flex flex-col items-center justify-center gap-4 sm:flex-row sm:gap-6">
      <Image
        src={alcalde}
        alt={`Alcalde ${municipalidad.alcalde}`}
        width={220}
        height={262}
        format="webp"
        quality={85}
        loading="lazy"
        class="flota h-36 w-auto shrink-0 drop-shadow-[0_10px_20px_rgba(0,0,0,0.55)] sm:h-44"
      />
      <div class="text-center sm:text-left">
        <p class="font-display text-2xl text-oro-300">{municipalidad.nombre}</p>
        <p class="mt-1 text-lg font-bold text-white/95">Alcalde: {municipalidad.alcalde}</p>
        <p class="mt-0.5 text-sm text-white/75">Gestión Municipal 2023–2026</p>
        <p class="mt-4 text-sm text-white/80">
          Sitio hecho por
          <a
            href={desarrollador.url}
            target="_blank"
            rel="noopener noreferrer"
            class="font-bold text-white underline underline-offset-2"
          >{desarrollador.nombre}</a>
        </p>
      </div>
    </div>
  </div>
</footer>
